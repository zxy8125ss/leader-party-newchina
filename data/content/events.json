      "after": [
        {
          "id": "E1927-BQHY",
          "note": "起义后数日，中央在汉口召开紧急会议，正式确定武装反抗的总方针"
        },
        {
          "id": "E1928-JGSHS",
          "note": "起义保留下来的部分部队由朱德、陈毅率领，后来上井冈山与毛泽东部会师"
        }
      ],
